@@ -586,6 +586,20 @@
  * \retval 1 unloading
  */
 
+/* The modem may expose outgoing progress only in CLCC snapshots. */
+static int outgoing_setup_pending(struct pvt *pvt)
+{
+	struct cpvt *cpvt;
+	AST_LIST_TRAVERSE(&pvt->chans, cpvt, entry) {
+		if (cpvt->channel && cpvt->dir == CALL_DIR_OUTGOING &&
+		    (cpvt->state == CALL_STATE_INIT || cpvt->state == CALL_STATE_DIALING ||
+		     cpvt->state == CALL_STATE_ALERTING)) {
+			return 1;
+		}
+	}
+	return 0;
+}
+
 static void* do_monitor_phone (void* data)
 {
 	struct pvt*	pvt = (struct pvt*) data;
@@ -657,7 +671,7 @@
 
