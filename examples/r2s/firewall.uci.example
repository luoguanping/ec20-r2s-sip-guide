# Merge these named sections into /etc/config/firewall. Check with fw4 check.
config zone 'sipwg'
        option name 'sipwg'
        list network 'wgsip'
        option input 'REJECT'
        option output 'ACCEPT'
        option forward 'REJECT'

config rule 'sipwg_in'
        option name 'Allow VPS SIP to R2S container'
        option src 'sipwg'
        option src_ip '10.77.38.1'
        option dest '*'
        option dest_ip '172.30.77.2'
        option proto 'udp'
        option dest_port '5060 10000-10099'
        option target 'ACCEPT'

config rule 'sipwg_out'
        option name 'Allow R2S container SIP to VPS'
        option src '*'
        option src_ip '172.30.77.2'
        option dest 'sipwg'
        option dest_ip '10.77.38.1'
        option proto 'udp'
        option dest_port '5060 12000-12049'
        option target 'ACCEPT'
